# Website lead intake
RAINMAKER_BASE_URL=
RAINMAKER_API_KEY=
# Optional override if Rainmaker intake is not hosted at /api/leads/intake.
RAINMAKER_LEAD_INTAKE_URL=

# Lead notification email
RESEND_API_KEY=
FROM_EMAIL=
# Optional comma-separated list. cfoley@edgpatioshade.com is always included.
NOTIFICATION_EMAIL=
# Optional. Set true only if EDG wants automatic 7-day customer follow-up emails.
ENABLE_LEAD_FOLLOW_UP_EMAILS=false

# Internal admin endpoints
ADMIN_API_KEY=

# Optional scripts
GOOGLE_PLACES_API_KEY=
