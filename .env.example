# Website lead intake
RAINMAKER_BASE_URL=
RAINMAKER_API_KEY=
# Optional override if Rainmaker intake is not hosted at /api/leads/intake.
RAINMAKER_LEAD_INTAKE_URL=
# Temporary emergency fallback only. Production leads should live in Rainmaker.
ALLOW_SUPABASE_LEAD_FALLBACK=false

# Supabase is retained for legacy analytics/admin reads and explicit fallback only.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notification email
RESEND_API_KEY=
FROM_EMAIL=
# Optional comma-separated list. cfoley@edgpatioshade.com is always included.
NOTIFICATION_EMAIL=

# Internal admin endpoints
ADMIN_API_KEY=

# Optional scripts
GOOGLE_PLACES_API_KEY=
